{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "inStock": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "price", "createdAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "A product in a user's wishlist",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "addedAt": { "type": "number" }
      },
      "required": ["productId", "addedAt"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "User roles for admin access",
      "type": "object",
      "properties": {
        "isAdmin": { "type": "boolean" }
      },
      "required": ["isAdmin"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products inventory"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "User's wishlist items"
    },
    "/userRoles/{userId}": {
      "schema": { "$ref": "#/entities/UserRole" },
      "description": "Role assignments"
    }
  }
}
