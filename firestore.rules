rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'halmontaser1@gmail.com' || exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))); 
    }

    match /products/{productId} {
      function isValidProductVariant(variant) {
        return variant is map &&
          variant.keys().hasAll(['id', 'name', 'price', 'stockQuantity', 'inStock']) &&
          variant.id is string && variant.id.size() <= 128 &&
          variant.name is string && variant.name.size() <= 200 &&
          variant.price is number && variant.price >= 0 &&
          variant.stockQuantity is number && variant.stockQuantity >= 0 &&
          variant.inStock is bool;
      }
      
      function validateProductVariants(variants) {
        return variants is list && variants.size() <= 100 && (variants.size() == 0 || isValidProductVariant(variants[0]));
      }

      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'price', 'createdAt', 'updatedAt']) &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
          data.price is number && data.price >= 0 &&
          (true) && // Allowing optional fields for simplicity here or enforce them?
          // Let's enforce the exact fields
          (data.keys().hasOnly(['name', 'description', 'price', 'imageUrl', 'category', 'inStock', 'stockQuantity', 'variants', 'createdAt', 'updatedAt'])) &&
          (data.get('description', '') is string && data.get('description', '').size() <= 2000) &&
          (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 600000) &&
          (data.get('category', '') is string && data.get('category', '').size() <= 100) &&
          (data.get('inStock', true) is bool) &&
          (data.get('stockQuantity', 0) is number && data.get('stockQuantity', 0) >= 0) &&
          validateProductVariants(data.get('variants', []));
      }

      allow list: if true;
      allow get: if isValidId(productId);
      
      allow create: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
        
      allow update: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'description', 'price', 'imageUrl', 'category', 'inStock', 'stockQuantity', 'variants', 'updatedAt']) &&
        incoming().updatedAt == request.time &&
        incoming().createdAt == existing().createdAt;
        
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /users/{userId}/wishlist/{productId} {
      function isValidWishlistItem(data) {
        return data.keys().hasAll(['productId', 'addedAt']) &&
          data.keys().hasOnly(['productId', 'addedAt']) &&
          data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
          data.addedAt is timestamp;
      }

      allow list: if isSignedIn() && userId == request.auth.uid;
      allow get: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(productId);
      
      allow create: if isSignedIn() && 
        userId == request.auth.uid &&
        isValidId(userId) &&
        isValidId(productId) &&
        isValidWishlistItem(incoming()) &&
        incoming().productId == productId &&
        incoming().addedAt == request.time &&
        exists(/databases/$(database)/documents/products/$(productId));
        
      allow delete: if isSignedIn() && 
        userId == request.auth.uid &&
        isValidId(userId) &&
        isValidId(productId);
    }
    
    match /userRoles/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid && isValidId(userId);
    }
    
    match /orders/{orderId} {
      function isValidOrderItem(item) {
        return item is map &&
          item.keys().hasAll(['productId', 'name', 'price', 'quantity']) &&
          item.productId is string && item.productId.size() <= 128 &&
          item.name is string && item.name.size() <= 200 &&
          item.price is number && item.price >= 0 &&
          item.quantity is number && item.quantity > 0;
      }
      
      function validateOrderItems(items) {
        return items is list && items.size() > 0 && items.size() <= 100 &&
          isValidOrderItem(items[0]);
      }

      function isValidOrder(data) {
        return data.keys().hasAll(['customerName', 'customerEmail', 'customerPhone', 'shippingAddress', 'totalAmount', 'status', 'items', 'createdAt', 'updatedAt']) &&
          data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
          data.customerEmail is string && data.customerEmail.size() > 0 && data.customerEmail.size() <= 200 &&
          data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 50 &&
          data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 1000 &&
          data.totalAmount is number && data.totalAmount >= 0 &&
          data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
          validateOrderItems(data.items);
      }

      // Allow anyone with the exact orderId to read it (acting as a tracking pin for guests)
      allow get: if isValidId(orderId);
      
      // Allow users to list their own orders, or admins to list all
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      // Anyone can create an order
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        (incoming().get('userId', null) == (request.auth != null ? request.auth.uid : null)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
        
      allow update: if isAdmin() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().createdAt == existing().createdAt;
        
      allow delete: if isAdmin() && isValidId(orderId);
    }
  }
}
